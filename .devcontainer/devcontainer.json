{
  "name": "Architect",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // The Vite dev server (npm run dev).
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Architect (Vite)", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/post-create-script.sh",
  "customizations": {
    "vscode": {
      "extensions": ["vitest.explorer"]
    }
  }
}
